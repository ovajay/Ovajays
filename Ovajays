<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Massage Terminbuchung</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <header>
        <h1>Massage Termin buchen</h1>
    </header>
    
    <main>
        <form id="booking-form">
            <label for="name">Name:</label>
            <input type="text" id="name" required>

            <label for="email">E-Mail:</label>
            <input type="email" id="email" required>

            <label for="date">Datum:</label>
            <input type="date" id="date" required>

            <label for="time">Uhrzeit:</label>
            <input type="time" id="time" required>

            <label for="massage-type">Massageart:</label>
            <select id="massage-type">
                <option>Entspannungsmassage</option>
                <option>Tiefengewebsmassage</option>
                <option>Sportmassage</option>
            </select>

            <button type="submit">Termin buchen</button>
        </form>
        
        <p id="confirmation-message" class="hidden">Dein Termin wurde gebucht!</p>
    </main>

    <script src="script.js"></script>
</body>
</html>
